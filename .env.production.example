POSTGRES_DB=backend_kpi
POSTGRES_USER=backend_kpi
POSTGRES_PASSWORD=replace-with-a-long-random-password
HTTP_PORT=8080
APP_ORIGIN=https://kpi.example.internal
JWT_SECRET=
JWT_TTL_SECONDS=28800
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Jira Data Center
JIRA_BASE_URL=https://jira.example.internal
JIRA_PROJECT_KEY=BE
JIRA_AUTH_TYPE=pat
JIRA_TOKEN=
JIRA_USER=
JIRA_DEFAULT_JQL=ORDER BY created DESC
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_DEADLINE_FIELD=duedate
JIRA_DONE_STATUSES=Done,Closed,Resolved
JIRA_SYNC_MAX_ISSUES=1000
JIRA_RETRY_ATTEMPTS=3
JIRA_REQUEST_TIMEOUT_MS=15000
# Optional server-side scheduler; 0 disables automatic sync.
JIRA_SYNC_INTERVAL_MINUTES=0
