PORT=8788
DB_PATH=./data/backend-kpi.sqlite
APP_ORIGIN=http://localhost:5175,http://127.0.0.1:5175
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL_SECONDS=28800
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-initial-password
JIRA_BASE_URL=https://jira.fptplay.net
JIRA_PROJECT_KEY=BE
JIRA_AUTH_TYPE=pat
JIRA_TOKEN=replace-with-jira-token
JIRA_USER=
JIRA_STORY_POINTS_FIELD=customfield_10016
JIRA_DEADLINE_FIELD=duedate
JIRA_DONE_STATUSES=Done,Closed,Resolved
SYNC_MAX_RESULTS=1000
JIRA_SYNC_MAX_ISSUES=1000
JIRA_SEARCH_FIELDS=summary,assignee,status,priority,labels,issuetype,created,updated
JIRA_DEFAULT_JQL=project = BE AND labels = Sprint26 ORDER BY lastViewed DESC
